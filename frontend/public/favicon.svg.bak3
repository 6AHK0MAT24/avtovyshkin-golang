<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <!-- Черный фон -->
  <rect width="64" height="64" rx="12" fill="#1A1A1A"/>
  
  <!-- Кузов-платформа грузовика -->
  <rect x="8" y="42" width="36" height="10" rx="2" fill="#FFFFFF"/>
  
  <!-- Кабина -->
  <rect x="6" y="36" width="12" height="16" rx="2" fill="#FFFFFF"/>
  <rect x="8" y="38" width="8" height="6" rx="1" fill="#1A1A1A" opacity="0.7"/>
  
  <!-- Колеса -->
  <circle cx="16" cy="52" r="5" fill="#FFFFFF"/>
  <circle cx="16" cy="52" r="3" fill="#1A1A1A"/>
  <circle cx="38" cy="52" r="5" fill="#FFFFFF"/>
  <circle cx="38" cy="52" r="3" fill="#1A1A1A"/>
  
  <!-- Телескопическая стрела (выдвинута вверх-вправо) -->
  <line x1="28" y1="42" x2="50" y2="16" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
  
  <!-- Сегменты стрелы -->
  <line x1="28" y1="42" x2="38" y2="30" stroke="#E0E0E0" stroke-width="5" stroke-linecap="round"/>
  <line x1="38" y1="30" x2="50" y2="16" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
  
  <!-- Люлька (корзина) -->
  <rect x="46" y="10" width="10" height="7" rx="1" fill="#FFFFFF"/>
  <line x1="50" y1="16" x2="51" y2="10" stroke="#FFFFFF" stroke-width="2"/>
  
  <!-- Гидроцилиндр основания -->
  <rect x="24" y="40" width="6" height="4" rx="1" fill="#FFFFFF"/>
  
  <!-- Упоры (стабилизаторы) -->
  <line x1="8" y1="50" x2="4" y2="54" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
  <line x1="44" y1="50" x2="48" y2="54" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
</svg>