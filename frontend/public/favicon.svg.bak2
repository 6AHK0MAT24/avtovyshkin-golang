<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <!-- Грузовик -->
  <rect x="4" y="40" width="24" height="12" rx="2" fill="#2563eb"/>
  <rect x="6" y="32" width="20" height="8" fill="#3b82f6"/>
  <rect x="8" y="28" width="16" height="4" fill="#60a5fa"/>
  <!-- Колеса грузовика -->
  <circle cx="10" cy="54" r="5" fill="#1e293b"/>
  <circle cx="22" cy="54" r="5" fill="#1e293b"/>
  <circle cx="10" cy="54" r="2" fill="#64748b"/>
  <circle cx="22" cy="54" r="2" fill="#64748b"/>
  <!-- Подъемная стрела -->
  <rect x="26" y="38" width="4" height="20" fill="#f59e0b"/>
  <rect x="28" y="18" width="3" height="22" fill="#fbbf24" transform="rotate(-30 29.5 40)"/>
  <!-- Платформа -->
  <rect x="42" y="8" width="16" height="6" rx="1" fill="#f59e0b"/>
  <rect x="44" y="14" width="12" height="2" fill="#d97706"/>
  <!-- Опоры -->
  <rect x="24" y="52" width="8" height="4" fill="#64748b"/>
  <rect x="24" y="56" width="2" height="4" fill="#475569"/>
  <rect x="30" y="56" width="2" height="4" fill="#475569"/>
</svg>